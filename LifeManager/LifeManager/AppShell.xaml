<Shell
    x:Class="LifeManager.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:LifeManager"
    Title="LifeManager"
    Shell.BackgroundColor="{DynamicResource ThemeBackground}"
    Shell.TitleColor="{DynamicResource ThemeText}"
   Shell.ForegroundColor="{DynamicResource ThemeAccent}"
   >

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

</Shell>