<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:LifeManager.Converters"
             xmlns:viewmodels="clr-namespace:LifeManager.ViewModels"
             xmlns:models="clr-namespace:LifeManager.Models"
             x:DataType="viewmodels:MainViewModel"
             x:Class="LifeManager.MainPage">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:PriorityNameConverter x:Key="PriorityNameConverter" />
            <converters:PriorityColorConverter x:Key="PriorityColorConverter" />
        </ResourceDictionary>
        
    </ContentPage.Resources>

    <ScrollView>
        
		<VerticalStackLayout Padding="20" Spacing="15">

            <Grid ColumnDefinitions="*,Auto">

                <Button
    Grid.Column="1"
    Text="⚙"
    FontSize="28"
    TextColor="{DynamicResource ThemeText}"
    BackgroundColor="Transparent"
    BorderWidth="0"
    Padding="5"
    WidthRequest="45"
    HeightRequest="45"
    Clicked="OnSettingsClicked"
    SemanticProperties.Description="Open settings" />

            </Grid>
            <Label
        Text="My To-Do List"
        x:Name="PageTitle"
        FontSize="24"
        FontAttributes="Bold" />
            <Label
    x:Name="WeatherLabel"
    Text="{Binding WeatherText}"
    FontSize="16" />
            <Entry
    x:Name="TaskEntry"
    Placeholder="Enter a new task..."
    TextColor="{DynamicResource ThemeText}"
    PlaceholderColor="{DynamicResource ThemeSecondaryText}"
    BackgroundColor="{DynamicResource ThemeSurface}" />
            <Grid ColumnDefinitions="*,*,2*" ColumnSpacing="12">

                <!-- Priority -->
                <Picker
        Grid.Column="0"
        x:Name="PriorityPicker"
        Title="Select priority"
        SelectedIndex="0"
        TextColor="{DynamicResource ThemeText}"
        TitleColor="{DynamicResource ThemeSecondaryText}"
        BackgroundColor="{DynamicResource ThemeSurface}"
        VerticalOptions="End"            
                    >

                    <Picker.Items>
                        <x:String>Low</x:String>
                        <x:String>Medium</x:String>
                        <x:String>High</x:String>
                    </Picker.Items>

                </Picker>

                <!-- Due date -->
                <DatePicker
        Grid.Column="1"
        x:Name="DueDatePicker"
        Format="dd.MM.yyyy"
        TextColor="{DynamicResource ThemeText}" 
        VerticalOptions="End"            
                    />

                <!-- Category -->
                <Picker
        Grid.Column="2"
        x:Name="CategoryPicker"
        Title="Select category"
       ItemDisplayBinding="{Binding Name, x:DataType={x:Type models:Category}}"
        ItemsSource="{Binding Categories}"            
        VerticalOptions="End"            
                    />

            </Grid>
            <!-- Display the category name instead of the Category object -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                <Button
        Grid.Column="0"
        Text="+ New Category"
        HorizontalOptions="Start"
        Clicked="OnNewCategoryClicked" />

                <Button
        Grid.Column="1"
        Text="Add Task"
        Clicked="OnAddTaskClicked" />

            </Grid>

            <Label
    Text="Top 3 Priority Tasks"
    FontSize="20"
    FontAttributes="Bold" />

            <CollectionView
    x:Name="TopTasksList"
    ItemsSource="{Binding TopTasks}"
    SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TodoTask">
                        <HorizontalStackLayout Spacing="12" Padding="0,4">

                            <Label
                    Text="{Binding Title}"
                    FontSize="16"
                    VerticalOptions="Center" />

                            <Border
    BackgroundColor="{Binding Priority, Converter={StaticResource PriorityColorConverter}}"
    StrokeThickness="0"
    StrokeShape="RoundRectangle 8"
    Padding="10,5">

                                <Label
        Text="{Binding Priority, Converter={StaticResource PriorityNameConverter}}"
        FontSize="12"
        TextColor="Black"
        VerticalOptions="Center" />

                            </Border>

                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">

                <Label
        Grid.Column="0"
        Text="My Tasks"
        FontSize="20"
        FontAttributes="Bold"
        VerticalOptions="Center" />

                <Picker
        Grid.Column="1"
        x:Name="CategoryFilterPicker"
        Title="All categories"
        WidthRequest="200"
        ItemDisplayBinding="{Binding Name, x:DataType={x:Type models:Category}}"
        SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
        ItemsSource="{Binding FilterCategories}"            
        />

                <Picker
        Grid.Column="2"
        x:Name="SortPicker"
        Title="Sort by"
        WidthRequest="130"
        SelectedIndex="{Binding SelectedSortIndex, Mode=TwoWay}"
        TextColor="{DynamicResource ThemeText}"
        BackgroundColor="{DynamicResource ThemeSurface}">

                    <Picker.Items>
                        <x:String>Priority</x:String>
                        <x:String>Due date</x:String>
                    </Picker.Items>

                </Picker>

            </Grid>

            <CollectionView
    x:Name="TaskList"
    ItemsSource="{Binding FilteredTasks}"
    SelectionMode="None" />


		</VerticalStackLayout>
        

	</ScrollView>

</ContentPage>
