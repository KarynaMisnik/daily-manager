<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LifeManager.MainPage">
  
    <ScrollView>
		<VerticalStackLayout Padding="20" Spacing="15">
            <Grid ColumnDefinitions="*,Auto">

                <Button
    Grid.Column="1"
    Text="⚙"
    FontSize="28"
    TextColor="{DynamicResource ThemeText}"
    BackgroundColor="Transparent"
    BorderWidth="0"
    Padding="5"
    WidthRequest="45"
    HeightRequest="45"
    Clicked="OnSettingsClicked"
    SemanticProperties.Description="Open settings" />

                <!-- ColumnDefinitions="*,Auto" creates two columns.
* takes the available space on the left.
Auto takes only the space needed for the button.
Grid.Column="1" places Settings in the right column. -->

            </Grid>
            <Label
        Text="My To-Do List"
        x:Name="PageTitle"
        FontSize="24"
        FontAttributes="Bold" />
            <Label
    x:Name="WeatherLabel"
    Text="Loading weather..."
    FontSize="16" />
            <Entry
    x:Name="TaskEntry"
    Placeholder="Enter a new task..."
    TextColor="{DynamicResource ThemeText}"
    PlaceholderColor="{DynamicResource ThemeSecondaryText}"
    BackgroundColor="{DynamicResource ThemeSurface}" />
            <Grid ColumnDefinitions="*,*,2*" ColumnSpacing="12">

                <!-- Priority -->
                <Picker
        Grid.Column="0"
        x:Name="PriorityPicker"
        Title="Select priority"
        SelectedIndex="0"
        TextColor="{DynamicResource ThemeText}"
        TitleColor="{DynamicResource ThemeSecondaryText}"
        BackgroundColor="{DynamicResource ThemeSurface}"
        VerticalOptions="End"            
                    >

                    <Picker.Items>
                        <x:String>Low</x:String>
                        <x:String>Medium</x:String>
                        <x:String>High</x:String>
                    </Picker.Items>

                </Picker>

                <!-- Due date -->
                <DatePicker
        Grid.Column="1"
        x:Name="DueDatePicker"
        Format="dd.MM.yyyy"
        TextColor="{DynamicResource ThemeText}" 
        VerticalOptions="End"            
                    />

                <!-- Category -->
                <Picker
        Grid.Column="2"
        x:Name="CategoryPicker"
        Title="Select category"
        ItemDisplayBinding="{Binding Name}" 
        VerticalOptions="End"            
                    />

            </Grid>
            <!-- Display the category name instead of the Category object -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                <Button
        Grid.Column="0"
        Text="+ New Category"
        HorizontalOptions="Start"
        Clicked="OnNewCategoryClicked" />

                <Button
        Grid.Column="1"
        Text="Add Task"
        Clicked="OnAddTaskClicked" />

            </Grid>

            <Label
    Text="Top 3 Priority Tasks"
    FontSize="20"
    FontAttributes="Bold" />

            <VerticalStackLayout
    x:Name="TopTasksList"
    Spacing="8" />

            <Grid ColumnDefinitions="*,Auto">

                <Label
        Grid.Column="0"
        Text="My Tasks"
        FontSize="20"
        FontAttributes="Bold"
        VerticalOptions="Center" />

                <Picker
        Grid.Column="1"
        x:Name="CategoryFilterPicker"
        Title="All categories"
        WidthRequest="200"
        ItemDisplayBinding="{Binding Name}"
        SelectedIndexChanged="OnCategoryFilterChanged" />

            </Grid>

            <VerticalStackLayout
                x:Name="TaskList"
                Spacing="10" />

		</VerticalStackLayout>
        

	</ScrollView>

</ContentPage>
