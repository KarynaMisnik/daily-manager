<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LifeManager.MainPage">

	<ScrollView>
		<VerticalStackLayout Padding="20" Spacing="15">
            <Button
    Text="Settings"
    Clicked="OnSettingsClicked" />
			<Label
        Text="My To-Do List"
        x:Name="PageTitle"
        FontSize="24"
        FontAttributes="Bold" />
            <Label
    x:Name="WeatherLabel"
    Text="Loading weather..."
    FontSize="16" />
			<Entry
				x:Name="TaskEntry"
				Placeholder="Enter a new task..." />
            <Picker
    x:Name="PriorityPicker"
    Title="Select priority"
    SelectedIndex="0">
                <Picker.Items>
                    <x:String>Low</x:String>
                    <x:String>Medium</x:String>
                    <x:String>High</x:String>
                </Picker.Items>
            </Picker>
            <DatePicker
    x:Name="DueDatePicker"
    Format="dd.MM.yyyy" />
            <Button
    Text="Add task"
    Clicked="OnAddTaskClicked" />

            <Label
    Text="Top 3 Priority Tasks"
    FontSize="20"
    FontAttributes="Bold" />

            <VerticalStackLayout
    x:Name="TopTasksList"
    Spacing="8" />

            <VerticalStackLayout
                x:Name="TaskList"
                Spacing="10" />

		</VerticalStackLayout>
        

	</ScrollView>

</ContentPage>
